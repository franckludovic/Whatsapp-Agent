GOOGLE_API_KEY_AGENT=your_google_key_here
# Set this to a model that is currently available (see the Gemini error message or ai.google.dev)
GEMINI_MODEL=gemini-2.5-flash
ADMIN_USER=admin
ADMIN_PASSWORD=choose_a_strong_password
PORT=3000
# Leave empty locally. On a VPS, set DATA_DIR=/opt/whatsapp-bot/data
DATA_DIR=
